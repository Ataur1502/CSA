# Copy this file to .env before running Docker Compose.
# Replace these values before deploying to a public GCP VM.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
PRIVATE_MODEL_KEY=
DEBUG=False

# Add the VM external IP and/or DNS name, comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
# Add https://your-domain.example here when using HTTPS/admin.
CSRF_TRUSTED_ORIGINS=
# Optional comma-separated origins if a separate frontend needs direct API access.
CORS_ALLOWED_ORIGINS=
